# Response headers for Cloudflare Pages. Pages reads this file at deploy time and does not serve it.
# The content security policy itself is in index.html, so the development server enforces it too. A meta tag cannot
# set frame-ancestors, so that part is sent here.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Webpack names these files by their content, so a changed file always gets a new name and browsers can keep them.
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/webApp.*
  Cache-Control: public, max-age=31536000, immutable

# Compose resources keep their names, but the app requests them with a fingerprint of their content in the `v` query
# (VersionedWebResources.kt), so a changed file always gets a new URL. Browsers and the edge, whose cache key includes
# the query, can keep them too. To force new copies, change the fingerprint's salt in the root build script.
/composeResources/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else, including the page, keeps Pages' default of revalidating.

# Only the custom domain should be indexed, not the project's pages.dev address.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
