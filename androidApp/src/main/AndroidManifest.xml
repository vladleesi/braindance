<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BraindanceApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Crashlytics reports crashes from release builds only; see androidApp/build.gradle.kts. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />
        <!-- singleTop: a link opened while the app is in front reaches the running screen through onNewIntent.
             configChanges: Compose lays out again by itself, so rotating or resizing keeps the activity and a playing
             trailer. Read the window size through windowSize() in shared WindowSize.kt. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android App Links: links to the Web app's screens open here once Android has verified the domain
                 through webApp/src/wasmJsMain/resources/.well-known/assetlinks.json; otherwise they stay in the
                 browser. Keep the paths in step with webPathToRoute in shared BrowserHistory.kt. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.braindancegg.com" />
                <data android:path="/" />
                <data android:pathPrefix="/games/" />
                <data android:pathPrefix="/game/" />
                <data android:pathPrefix="/giveaway/" />
                <data android:path="/events" />
                <data android:pathPrefix="/events/" />
                <data android:path="/popular" />
                <data android:path="/anticipated" />
                <data android:path="/giveaways" />
                <data android:path="/discover" />
                <data android:path="/releases" />
                <data android:path="/news" />
                <data android:path="/library" />
                <data android:path="/profile" />
            </intent-filter>
        </activity>
    </application>
</manifest>
