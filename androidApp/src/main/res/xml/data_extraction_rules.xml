<!-- An include allowlist excludes all other domains and paths, including future credentials and databases. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="backup_exports/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup_exports/" />
    </device-transfer>
</data-extraction-rules>
